<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AccioData29.MasterSlave</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>AccioData29</Authors>
    <Description>Implementación genérica del patrón Master-Slave para .NET 8. Incluye distribución Round-Robin, soporte para CancellationToken e integración con el sistema de DI de .NET.</Description>
    <PackageTags>master-slave pattern dotnet csharp parallel distributed</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="src\AccioData29.MasterSlave.Domain\AccioData29.MasterSlave.Domain.csproj" />
    <ProjectReference Include="src\AccioData29.MasterSlave.Application\AccioData29.MasterSlave.Application.csproj" />
  </ItemGroup>
</Project>
